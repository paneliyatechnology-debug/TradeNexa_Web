# ==============================================================================
# TradeNexa Web — Environment Template (.env.example)
# ==============================================================================
# Instructions for Developers:
# 1. Copy this file to `.env` (or `.env.local` for local dev).
# 2. Set NEXT_PUBLIC_ENV to 'local', 'dev', or 'live'.
# 3. Fill in your Firebase credentials if using Phone Auth / Push Notifications.
# ==============================================================================

# ⚙️ 1. Active Environment Selector: 'local' | 'dev' | 'live'
NEXT_PUBLIC_ENV=local

# ------------------------------------------------------------------------------
# 🌐 2. Active Backend Overrides (Uncomment the one matching your active env)
# ------------------------------------------------------------------------------

# --- [A] LOCAL Backend (e.g., local server running on port 5000) ---
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# --- [B] DEV Backend (Railway Development Server) ---
# NEXT_PUBLIC_BACKEND_ORIGIN=https://tradenexabackend-dev.up.railway.app
# NEXT_PUBLIC_API_BASE_URL=https://tradenexabackend-dev.up.railway.app/api/v1

# --- [C] LIVE Backend (Railway Production Server) ---
# NEXT_PUBLIC_BACKEND_ORIGIN=https://tradenexabackend-production.up.railway.app
# NEXT_PUBLIC_API_BASE_URL=https://tradenexabackend-production.up.railway.app/api/v1

# ------------------------------------------------------------------------------
# 🔧 3. Preset Environment Endpoints (Default fallbacks for each environment)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_LOCAL_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_DEV_BACKEND_URL=
NEXT_PUBLIC_LIVE_BACKEND_URL=

# ------------------------------------------------------------------------------
# 🔥 4. Firebase Configuration (Phone Auth & FCM Web Push Notifications)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
