# ==============================================================================
# TradeNexa Web — Environment Configuration
# ==============================================================================

# ⚙️ Quick Environment Switch: 'local' | 'dev' | 'live'
NEXT_PUBLIC_ENV=live

# ------------------------------------------------------------------------------
# 1. LOCAL Backend (Run frontend & backend locally)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_ENV=local
# NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:5000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# 2. DEV Backend (Railway Development Server)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_ENV=dev
# NEXT_PUBLIC_BACKEND_ORIGIN=https://tradenexabackend-dev.up.railway.app
# NEXT_PUBLIC_API_BASE_URL=https://tradenexabackend-dev.up.railway.app/api/v1

# ------------------------------------------------------------------------------
# 3. LIVE Backend (Railway Production Server)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_ORIGIN=https://tradenexabackend-production.up.railway.app
NEXT_PUBLIC_API_BASE_URL=https://tradenexabackend-production.up.railway.app/api/v1

# Optional legacy proxy
API_PROXY_TARGET=http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase Authentication (Phone Auth) & Cloud Messaging (Web Push)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
