# ==============================================================================
# TradeNexa Web — Environment Configuration
# ==============================================================================

# Quick Environment Switch: 'local' (testing) or 'live' (production)
NEXT_PUBLIC_ENV=local

# ------------------------------------------------------------------------------
# Manual URL Overrides (Optional - config/api.ts defaults to localhost or railway)
# ------------------------------------------------------------------------------
# For Local:
# NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# For Live (Railway):
# NEXT_PUBLIC_BACKEND_ORIGIN=https://tradenexabackend-dev.up.railway.app
# NEXT_PUBLIC_API_BASE_URL=https://tradenexabackend-dev.up.railway.app/api/v1

# Optional legacy proxy
API_PROXY_TARGET=http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (Web Push)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
